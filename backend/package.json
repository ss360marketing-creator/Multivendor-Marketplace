{
  "name": "multivendor-marketplace-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "build": "node node_modules/prisma/build/index.js generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:format": "node node_modules/prisma/build/index.js format",
    "prisma:studio": "node node_modules/prisma/build/index.js studio",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node node_modules/prisma/build/index.js db seed"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^10.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.0.1",
    "fastify": "^5.0.0",
    "pg": "^8.16.3",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.7.0"
  }
}
